# ── Telegram ─────────────────────────────────
BOT_TOKEN=123456789:ABCdefGhIJKlmnOPQrSTuVWxYz
# Global owner IDs (always act as admins in every group)
OWNER_IDS=111111111

# ── Database ─────────────────────────────────
# Local:   sqlite+aiosqlite:///./bot.db
# Railway: postgresql+asyncpg://user:pass@host:port/db
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# ── Behaviour defaults (per-group overridable from Telegram) ──
DEFAULT_WELCOME=👋 Welcome {first_name} to {group_name}! Please verify to join.
VERIFY_TIMEOUT_SECONDS=180
DEFAULT_WARN_LIMIT=3
MUTE_SECONDS=600
RAID_JOIN_THRESHOLD=10
RAID_WINDOW_SECONDS=60

# ── Logging ──────────────────────────────────
LOG_LEVEL=INFO
